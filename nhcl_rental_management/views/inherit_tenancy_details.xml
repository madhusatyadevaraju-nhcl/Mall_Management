<!--                        </group>-->
<!--                    </group>-->

<!--                    &lt;!&ndash; Row 2 &ndash;&gt;-->
<!--                    <group col="2" string="Lease Fit-Out Dates">-->
<!--                        <group>-->
<!--                            <field name="lease_date"/>-->
