<!--                        <group string="Fit-Out Check">-->
<!--                            <field name="fit_out_check"-->
<!--                                   widget="radio"-->
<!--                                   options="{'horizontal': True}"/>-->
<!--                        </group>-->
<!--                    </group>-->

<!--                    &lt;!&ndash; Row 4 &ndash;&gt;-->
