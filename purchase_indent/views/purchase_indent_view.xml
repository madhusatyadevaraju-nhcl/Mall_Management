<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_indent_view" model="ir.ui.view">
        <field name="name">purchase.indent.form</field>
        <field name="model">purchase.indent</field>
        <field name="arch" type="xml">
            <form string="Purchase Indent Form" class="o_purchase_order">
                <header>
                    <field name="state" widget="statusbar" nolabel="1"/>
                    <button name="action_submit" type="object" string="Send to Manager" state="draft"
                            invisible="state != 'draft'"/>
                    <button name="action_manager_approve" type="object" string="Manager Approve" state="submitted"
                            invisible="state != 'submitted'" groups="purchase_indent.purchase_manager_approval"/>
                    <button name="action_manager_refuse" type="object" string="Manager Refuse" state="submitted"
                            invisible="state != 'submitted'" groups="purchase_indent.purchase_manager_approval"
                            class="btn btn-secondary"/>
                    <button name="action_final_approve" type="object" string="Final Approved" state="manager_approved"
                            invisible="state != 'manager_approved'"
                            groups="purchase_indent.purchase_indent_final_approve"/>
                    <button name="action_create_rfq" type="object" string="Create RFQ" state="final_approved"
                            invisible="state != 'final_approved'"/>
                    <!--                    <button name="action_open_rfq"-->
                    <!--                            type="object"-->
                    <!--                            string="View RFQ"-->
                    <!--                            class="btn btn-primary"/>-->

                </header>
                <sheet>
                    <h4 style="color:blue;">
                        <field name="name"/>
                    </h4>
                    <group>
                        <group>
                            <field name="req_customer_id"/>
                            <field name="category"/>
                            <field name="vendor_id"/>

                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State"
                                       options="{'no_open': True, 'no_quick_create': True}"
                                       context="{'default_country_id': country_id}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country"
                                       options='{"no_open": True, "no_create": True}'/>
                            </div>
                            <!--                            <field name="purchase_order_id"  invisible="state != 'final_approved'"/>-->
                            <field name="fm_date"/>
                            <field name="to_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" mode="list,kanban">
                                <list editable="bottom" create="True" delete="True">
                                    <field name="product_id"/>
                                    <field name="product_des"/>
                                    <field name="product_qty"/>
                                    <field name="uom"/>
                                                                        <field name="hsn_code"/>
                                    <field name="price"/>
                                    <!--                                                                        <field name="taxes_id"/>-->
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval Info">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="approver_id"/>
                                    <field name="approval_stage"/>
                                    <field name="status"/>
                                    <field name="approved_date"/>
                                </list>
                            </field>
                        </page>

                        <!--                                         <page string="Description" name="description">-->
                        <!--                                                    <field name="reason" readonly="request_status != 'new'"/>-->
                        <!--                                         </page>-->
                    </notebook>
                </sheet>
                <!--                <div class="o_attachment_preview"/>-->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_purchase_indent_list" model="ir.ui.view">
        <field name="name">purchase.indent.list</field>
        <field name="model">purchase.indent</field>
        <field name="arch" type="xml">
            <list string="Purchase Indents">
                <field name="name"/>
                <field name="req_customer_id"/>
                <field name="category"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in  ['manager_approved','final_approved']"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_indent" model="ir.actions.act_window">
        <field name="name">Purchase Action Indent</field>
        <field name="res_model">purchase.indent</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="action_purchase_indent_form" model="ir.actions.act_window">
        <field name="name">Purchase Action Indent</field>
        <field name="res_model">purchase.indent</field>
        <field name="view_mode">form,kanban</field>
    </record>
    <record id="action_purchase_indent_kanban" model="ir.actions.act_window">
        <field name="name">Purchase Action Indent</field>
        <field name="res_model">purchase.indent</field>
        <field name="view_mode">kanban,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="limit">1</field>
    </record>

    <record id="view_purchase_indent_kanban" model="ir.ui.view">
        <field name="name">purchase.indent.kanban</field>
        <field name="model">purchase.indent</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_example" create="false">

                <!-- Declare all fields used in buttons -->
                <field name="vendor_id"/>
                <templates>
                    <t t-name="kanban-box">

                        <div style="border-radius: 30px;border-color: rgb(170 50 220 / 0.6);">
                            <div class="o_kanban_details">
                                <h4>Purchase Indent</h4>
                                <div>
                                    <img src="/purchase_indent/static/src/img/icon.png"
                                         class="oe_kanban_avatar me-2"
                                         width="64" height="64"
                                         alt="Indent Icon"/>
                                    <!--                                </div>-->
                                    <!--                                <div class="o_kanban_actions mt-2">-->
                                    <!--                                    <button type="action" class="btn btn-primary btn-sm"-->
                                    <!--                                            name="%(purchase_indent.action_purchase_indent_form)d"> -->
                                    <button type="object" class="btn btn-primary btn-sm"
                                            name="open_indent_form">
                                        New Request
                                    </button>
                                </div>
                            </div>
                        </div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <menuitem id="menu_purchase_indent_root"
              name="Purchase Indent"
              sequence="10"
              web_icon="purchase_indent,static/description/icon.png"
    />

    <!--    My Approvals-->
    <menuitem id="menu_indent_request_main_sub"
              name="My Approvals"
              parent="menu_purchase_indent_root"
              sequence="3"/>
    <!-- Submenu under Purchase Indent -->
    <menuitem id="menu_indent_request_form"
              name="New Requests"
              parent="menu_indent_request_main_sub"
              action="action_purchase_indent_kanban"
              sequence="10"/>
    <menuitem id="menu_indent_request"
              name="My Requests"
              parent="menu_indent_request_main_sub"
              action="action_purchase_indent"
              sequence="12"/>

    <!--    Another Submenu-->
    <menuitem id="menu_configuration"
              name="Configuration"
              parent="menu_purchase_indent_root"
              sequence="4"/>
    <menuitem id="menu_configuration_product"
              name="Product"
              parent="menu_configuration"
              action="product.product_template_action"
              sequence="1"
    />
    <menuitem id="menu_configuration_product_variants"
              name="Product Variants"
              parent="menu_configuration"
              action="product.product_normal_action"
              sequence="2"
    />

</odoo>